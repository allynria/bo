# Urga Service – Production Defaults (.env.example)
#
# Copy this to `.env` and adjust per environment.
# Notes:
# - In production, you MUST set `IDEMPOTENCY_REDIS_URL` to enable distributed locks
#   and avoid cross-pod duplicates.
# - Keep metrics low-cardinality: do not add `request_id`, `conv_id`, or `mac_id`
#   as labels to counters; those belong in logs/NDJSON ledger only.

# Hedging
LLM_HEDGE_FIRST_TOKEN_MS=500            # stream hedge threshold (ms)
LLM_HEDGE_NON_STREAM_MS=300             # non-stream hedge threshold (ms)

# Health checks
LLM_HEALTH_MODE=net                     # include lightweight provider probes
LLM_HEALTH_NET_TIMEOUT_MS=250           # probe timeout (ms)
LLM_HEALTH_TTL_MS=30000                 # cache provider health (ms)

# Idempotency and distributed locks
IDEMPOTENCY_TTL_MS=60000                # replay window (ms)
IDEMPOTENCY_LOCK_TTL_MS=60000           # lock TTL for duplicate gating (ms)
IDEMPOTENCY_SKEW_MS=1500                # drift tolerance applied to TTLs (ms)
IDEMPOTENCY_REDIS_URL=redis://127.0.0.1:6379  # REQUIRED in prod; example local URL

# Budgets (set the ones you intend to enforce)
# Dollar budgets (sliding window)
TENANT_DOLLARS_BUDGET=0                 # e.g., 10.00 for $10 window
TENANT_DOLLARS_WINDOW_MS=0              # e.g., 3600000 for 1 hour
LLM_USD_PER_TOKEN_IN=0                  # set per model/provider cost
LLM_USD_PER_TOKEN_OUT=0                 # set per model/provider cost
LLM_EXPECTED_TOKENS_OUT=0               # expected out tokens for pre-check estimation

# Token budgets (sliding window)
TENANT_TOKENS_BUDGET=0                  # e.g., 50000 tokens per window
TENANT_TOKENS_WINDOW_MS=0               # e.g., 3600000 for 1 hour

# Monthly caps
TENANT_TOKENS_MONTHLY_BUDGET=0          # optional monthly token cap
TENANT_DOLLARS_MONTHLY_BUDGET=0         # optional monthly dollar cap

# Rolling window budgets
TENANT_TOKENS_ROLLING_BUDGET=0
TENANT_TOKENS_ROLLING_WINDOW_MS=0
TENANT_DOLLARS_ROLLING_BUDGET=0
TENANT_DOLLARS_ROLLING_WINDOW_MS=0
TENANT_ROLLING_BUCKET_MS=60000          # bucket granularity (ms)

# Soft-drop under pressure
CPU_SOFT_DROP_PCT=90                    # preemptive drop threshold for CPU
RSS_SOFT_DROP_MB=0                      # set just under container memory limit

# Security and auth
CONV_HMAC_SECRETS=                      # comma-separated secrets for HMAC MAC validation
CORS_ALLOWLIST=                         # comma-separated origins allowed to call conv endpoints
REPLAY_WINDOW_MS=30000                  # required timestamp window (ms)
REPLAY_SKEW_TOLERANCE_MS=5000           # tolerance for jitter (ms)

# Other operational knobs
SSE_HEARTBEAT_MS=2500                   # keepalive cadence for streams (ms)
HEDGE_CUTOVER_MAX_WAIT_MS=500           # wait for hedged replay on message duplicates (ms)

# Memory system (safe defaults)
MEMORY_ENABLED=1
MEMORY_STR_TTL_MS=1800000
MEMORY_STR_MAX_ITEMS=4
MEMORY_STR_SUMMARIZE_EVERY=4
MEMORY_EF_TTL_MS=604800000
MEMORY_EF_MAX_ITEMS=64
MEMORY_CF_TTL_MS=2592000000
MEMORY_CF_MAX_CHARS=8
MEMORY_INJECT_BUDGET_TOKENS=120
MEMORY_ECHO_PROB_PCT=35
MEMORY_MIN_IMPORTANCE=0.6

# Belief Fence (World & Character Consistency)
BELIEFS_ENABLED=1                       # gate for belief system
BELIEFS_MAX_PER_CHAR=64                 # per-character max stored beliefs
BELIEFS_INJECT_MAX=3                    # max belief nudges injected per turn
BELIEFS_HASH_PHRASE_COOLDOWN_MS=900000  # cooldown for same belief phrase (ms)
BELIEFS_CONFLICT_SSE=1                  # emit SSE on detected conflicts (dev-friendly)

# Contradiction Watchdog (consistency checks across recent turns)
CONTRADICT_ENABLED=1
CONTRADICT_MAX_LOOKBACK_TURNS=12
CONTRADICT_INJECT_STYLE=inline          # inline | system
CONTRADICT_STRICT=0                     # 1 makes injection more forceful
CONTRADICT_PENALIZE_TRUST=1             # nudges trust/suspicion (Step 3-ready)
# MAX_LOOKBACK_TURNS: how many recent turns to scan (rolling window).
# INJECT_STYLE: “inline” = diegetic whisper; “system” = explicit guardrail hint.
# --- Failure Roll Engine ---
FAILROLL_ENABLED=1
FAILROLL_BASE_CHANCE=0.35
FAILROLL_TRUST_WEIGHT=-0.35
FAILROLL_SUSPICION_WEIGHT=0.30
FAILROLL_TENSION_WEIGHT=0.20
FAILROLL_MIN=0.05
FAILROLL_MAX=0.90
FAILROLL_STYLE=diegetic
# meta prints result aside
# Regex of risky intents
FAILROLL_RISK_REGEX="(sneak|pick.*lock|lie|deceiv|steal|dodge|parry|charm|seduc|intimidat|bluff|hack|climb|jump.*gap|shoot.*from.*distance)"
FAILROLL_SSE_VERBOSE=1

# Near-miss → Phrase Cooldown synergy
NEARMISS_PHRASE_COOLDOWN_ENABLED=1     # enable cooling phrases on near-miss
NEARMISS_PHRASE_COOLDOWN_MS=90000      # TTL for cooled phrases (ms)
NEARMISS_PHRASE_COOLDOWN_PICK=2        # how many phrases to cool per near-miss
